{
	"name": "nimploy",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev:server": "pnpm --filter=@nimploy/lite run dev:server",
		"dev:client": "pnpm --filter=@nimploy/lite run dev:client",
		"dev": "pnpm --filter=@nimploy/lite run dev:server",
		"build": "pnpm --filter=@nimploy/lite run build",
		"build:server": "pnpm --filter=@nimploy/lite run build:server",
		"build:client": "pnpm --filter=@nimploy/lite run build:client",
		"test": "pnpm --filter=@nimploy/lite run test",
		"typecheck": "pnpm --filter=@nimploy/lite run build:server",
		"db:generate": "pnpm --filter=@nimploy/lite run db:generate",
		"db:migrate": "pnpm --filter=@nimploy/lite run db:migrate",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.4.0",
		"dotenv": "16.4.5",
		"lint-staged": "^15.5.2",
		"tsx": "4.22.4"
	},
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=9.0.0"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		]
	}
}
